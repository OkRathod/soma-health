// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // You will get this URL from Supabase later
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Physical Profile (Optional at start)
  nationality    String?  
  height         Float?   // Stored in cm
  weight         Float?   // Stored in kg

  // THE VAULT: Securely stored API Key
  // We never store the actual key, only the encrypted version
  encryptedApiKey String? 
  apiKeyIv        String? // Initialization Vector required for decryption

  // Relations
  logs           DailyLog[]
  tasks          Task[]

  // 👇 ADD THIS: Stores the date when the account will be permanently wiped
  scheduledForDeletion  DateTime?

  // 👇 ADD THIS: "metric" or "imperial"
  unitPreference  String  @default("metric")

  // 👇 NEW FIELDS FOR PROFILE
  age               Int?
  gender            String?  // "Male", "Female", "Other"
  activityLevel     String?  // "Sedentary", "Active", etc.
  jobType           String?  // "Desk Job", "Physical Labor" (Your specific request)
  dietaryPreferences String? // "Vegan", "Keto", etc.
  
  // Goals
  customPurpose     String?  // "Training for marathon" (Your specific request)
  weightGoal        String?  // "Lose", "Gain", "Maintain"
  targetWeight      Float?
  dailyCalorieGoal  Int      @default(2500)
  waterGoal         Int      @default(2500)
  
  // Membership
  plan              String   @default("Free") // For future use
  joinedAt          DateTime @default(now())

  feedback  Feedback[]
  
}

model DailyLog {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime @default(now())
  
  // Natural Language Input
  rawText        String   @db.Text
  
  // AI Analysis (Stored as JSON for flexibility)
  parsedData     Json?    
  // Example JSON structure:
  // { 
  //   "foods": [{ "name": "Dal", "calories": 150 }], 
  //   "exercises": [{ "name": "Squats", "sets": 3 }] 
  // }

  totalCaloriesIn  Int      @default(0)
  totalCaloriesOut Int      @default(0)
  
  // Coach's feedback for this specific log
  aiFeedback       String?  @db.Text

  user           User     @relation(fields: [userId], references: [id])

  waterMl         Int      @default(0)
}

model Task {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?   @db.Text
  
  // Scheduling
  date           DateTime  // The specific date for this task
  startTime      DateTime? // Optional: "Actual Time"
  durationMins   Int?      // Optional: For calendar sync later
  
  // Logic
  isRecurring    Boolean   @default(false)
  frequency      String?   // "DAILY", "WEEKLY" (For future use)
  parentId       String?   // If this is a daily copy, this points to the Master ID
  
  // Priority & Status
  priority       String    // "HIGH", "MEDIUM", "LOW", "HABIT"
  isCompleted    Boolean   @default(false)
  
  // Relations
  subtasks       SubTask[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt


  // 👇 ADD THIS LINE AT THE BOTTOM OF 'model Task'
  // This ensures a specific habit (parentId) can only appear once per day (date) for a user.
  @@unique([userId, parentId, date])
  @@index([userId, date])

}

model SubTask {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  title       String
  isCompleted Boolean  @default(false)
  
  // Tracking (Optional)
  targetValue Int?     // e.g. 10 (reps) or 2 (hours)
  currentValue Int?    // e.g. 5 (reps done so far)
  unit        String?  // "reps", "mins", "km", "chapters"
}

// Tracks completed content
model UserReadGuide {
  id        String   @id @default(cuid())
  userId    String
  guideSlug String   // Matches the slug in your static guides file
  readAt    DateTime @default(now())

  // Ensures a user can't read the same guide twice in the DB
  @@unique([userId, guideSlug])
}


model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  rating    Int      // 1-5 Star Rating
  category  String   // "BUG", "FEATURE", "GENERAL"
  
  // We store the specific answers as JSON so we can change questions later without breaking the DB
  answers   Json     
  
  createdAt DateTime @default(now())
}



model DailyMetrics {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // Store as Midnight (00:00:00) to ensure one per day
  
  steps       Int      @default(0)
  stepSource  String   @default("MANUAL") // "MANUAL" or "GOOGLE"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date]) // Prevents duplicate rows for the same day
}


// prisma/schema.prisma

model Deadline {
  id          String    @id @default(cuid())
  userId      String
  title       String
  
  startDate   DateTime  @default(now())
  targetDate  DateTime? // 👈 If null, it's a "No Deadline" task (Open-ended)
  
  isCompleted Boolean   @default(false)
  completedAt DateTime? 

  subtasks    DeadlineSubtask[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DeadlineSubtask {
  id          String   @id @default(cuid())
  title       String
  isCompleted Boolean  @default(false)
  
  deadlineId  String
  deadline    Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
}